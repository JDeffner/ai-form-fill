{
  "name": "ai-form-fill",
  "description": "Framework-agnostic library for AI-powered form filling. Extract structured data from unstructured text and automatically fill forms using Ollama or any OpenAI-compatible provider (OpenAI, Perplexity, OpenRouter, ...).",
  "version": "0.9.0",
  "keywords": [
    "ai",
    "form",
    "autofill",
    "llm",
    "openai",
    "ollama",
    "perplexity",
    "openrouter",
    "typescript",
    "form-filling",
    "data-extraction",
    "nlp",
    "machine-learning",
    "automation"
  ],
  "author": "Joel Deffner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDeffner/ai-form-fill.git"
  },
  "homepage": "https://github.com/JDeffner/ai-form-fill#readme",
  "bugs": {
    "url": "https://github.com/JDeffner/ai-form-fill/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.26.1",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/ai-form-fill.d.ts",
  "main": "./dist/ai-form-fill.cjs",
  "module": "./dist/ai-form-fill.js",
  "exports": {
    ".": {
      "types": "./dist/ai-form-fill.d.ts",
      "import": "./dist/ai-form-fill.js",
      "require": "./dist/ai-form-fill.cjs"
    },
    "./voice": {
      "types": "./dist/voice.d.ts",
      "import": "./dist/voice.js",
      "require": "./dist/voice.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "release:build": "pnpm build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^27.4.0",
    "lucide-react": "^1.33.0",
    "prettier": "^3.9.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-mock-dev-server": "^2.0.7",
    "vitest": "^4.0.18"
  }
}
