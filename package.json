{
  "name": "ai-form-fill",
  "description": "Framework-agnostic library for AI-powered form filling. Extract structured data from unstructured text and automatically fill forms using Ollama or any OpenAI-compatible provider (OpenAI, Perplexity, OpenRouter, ...).",
  "version": "2.0.0",
  "keywords": [
    "ai",
    "form",
    "autofill",
    "llm",
    "openai",
    "ollama",
    "perplexity",
    "openrouter",
    "typescript",
    "form-filling",
    "data-extraction",
    "nlp",
    "machine-learning",
    "automation"
  ],
  "author": "Joel Deffner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDeffner/ai-form-fill.git"
  },
  "homepage": "https://github.com/JDeffner/ai-form-fill#readme",
  "bugs": {
    "url": "https://github.com/JDeffner/ai-form-fill/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.26.1",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/ai-form-fill.d.ts",
  "main": "./dist/ai-form-fill.umd.cjs",
  "module": "./dist/ai-form-fill.js",
  "exports": {
    ".": {
      "types": "./dist/ai-form-fill.d.ts",
      "import": "./dist/ai-form-fill.js",
      "require": "./dist/ai-form-fill.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "release:build": "pnpm build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^27.4.0",
    "openai": "^6.16.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-mock-dev-server": "^2.0.7",
    "vitest": "^4.0.18"
  }
}
