# Copy this file to `.env` and fill in the keys you need.
# `.env` is gitignored — never commit real keys.
#
# These are read server-side only: by the dev-server mock proxies
# (mock/*.mock.ts, via vite.config loadEnv -> process.env) and the server proxy
# example (examples/server). They are deliberately NOT prefixed with `VITE_`,
# because Vite exposes VITE_-prefixed variables to browser code — an API key
# must never be inlined into a client bundle. The library itself reads no env.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Perplexity (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
